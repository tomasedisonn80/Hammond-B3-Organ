{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hammond:capture-corpus:v1",
  "title": "Project-proposed capture corpus index v1",
  "description": "Strict index shape. tools/capture_corpus.py additionally enforces exact Python integer types, bounded bytes/nodes/depth, capture/path/hash/file-ID uniqueness, parent resolution and acyclicity, manifest binding, purpose mapping, file confinement, aggregate limits and graph semantics. JSON Schema alone does not establish these properties or physical evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_origin", "corpus_id", "captures"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "contract_origin": {"const": "project-proposed-corpus-v1"},
    "corpus_id": {"$ref": "#/$defs/id"},
    "captures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capture"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "not": {"pattern": "[^a-z0-9_-]"}
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?:/[A-Za-z0-9][A-Za-z0-9._-]{0,63}){0,7}$",
      "not": {
        "anyOf": [
          {"pattern": "[^A-Za-z0-9._/-]"},
          {"pattern": "\\.(?:/|$)"},
          {"pattern": "(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$)"}
        ]
      }
    },
    "format": {
      "type": "string",
      "enum": ["wav_pcm16", "wav_pcm24", "wav_pcm32", "wav_float32", "wav_float64", "flac_pcm16", "flac_pcm24", "raw_float32_le"]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "properties": {
        "kind": {"type": "string", "enum": ["gesture", "family"]},
        "label": {"$ref": "#/$defs/id"}
      }
    },
    "derivedAudio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "format", "sample_rate_hz", "channel_count"],
      "properties": {
        "file_id": {"$ref": "#/$defs/id"},
        "format": {"$ref": "#/$defs/format"},
        "sample_rate_hz": {"type": "integer", "minimum": 1, "maximum": 768000},
        "channel_count": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_id", "manifest_path", "manifest_sha256", "purpose", "relation_labels", "parent_capture_ids", "derived_audio"],
      "properties": {
        "capture_id": {"$ref": "#/$defs/id"},
        "manifest_path": {"$ref": "#/$defs/portablePath"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "purpose": {"type": "string", "enum": ["fit", "validation", "final", "unassigned"]},
        "relation_labels": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relation"}
        },
        "parent_capture_ids": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "derived_audio": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/derivedAudio"}
        }
      }
    }
  }
}
