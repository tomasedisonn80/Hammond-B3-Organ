                "source_role": {
                  "const": "algorithm-and-boundary-only"
                },
                "uncertainty": {
                  "type": "null"
                },
                "measurement_reference": {
                  "type": "null"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^(?![\\s\\S]*[\\x00-\\x1f])(?=[\\s\\S]*\\S)[\\s\\S]*(?![\\s\\S])"
