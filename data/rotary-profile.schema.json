{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nominal effective-mouth rotary research profile v1",
  "$comment": "Run tools/validate_rotary_profile.py for cross-field slow/fast, rim-speed, all-orbit geometry, lexical-type and bounded-file admission. Schema conformance alone is not model admission. Physical quantities are synthetic proposals, not measurements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "model_id",
    "contract_id",
    "evidence_class",
    "applicable_variant",
    "source",
    "coordinate_frame",
    "signal_boundary",
    "speed_of_sound",
    "rotors",
    "microphones",
    "startup",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}(?![\\s\\S])"
    },
    "model_id": {
      "const": "nominal-effective-mouth-rotary-v1"
    },
    "contract_id": {
      "const": "rotary-numerics-v1"
    },
    "evidence_class": {
      "const": "proposed"
    },
    "applicable_variant": {
      "const": "synthetic-rotary-research"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "sha256",
        "basis"
      ],
      "properties": {
        "document": {
          "const": "Hammond_B3_Leslie_Research_Atlas_500pp.pdf"
        },
        "sha256": {
          "const": "4ae13c3065c60d733d0daa33817259b3198cdb959070baecadc2981678e5e769"
        },
        "basis": {
          "const": "algorithm-proposals-not-measured-values"
        }
      }
    },
    "coordinate_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handedness",
        "x_axis",
        "y_axis",
        "z_axis",
        "angle_zero",
        "positive_angle"
      ],
      "properties": {
        "handedness": {
          "const": "right"
        },
        "x_axis": {
          "const": "right-when-facing-cabinet-front"
        },
        "y_axis": {
          "const": "toward-cabinet-rear"
        },
        "z_axis": {
          "const": "up"
        },
        "angle_zero": {
          "const": "+x"
        },
        "positive_angle": {
          "const": "counterclockwise-viewed-from-positive-z"
        }
      }
    },
    "signal_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output",
        "directivity",
        "distance_gain",
        "reference_distance",
        "omitted_effects"
      ],
      "properties": {
        "input": {
          "const": "normalized-effective-mouth-amplitude"
        },
        "output": {
          "const": "normalized-propagated-amplitude"
        },
        "directivity": {
          "const": "unity-omnidirectional-diagnostic"
        },
        "distance_gain": {
          "const": "reference-distance-over-path-distance"
        },
        "reference_distance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "evidence"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0.02,
              "maximum": 10
            },
            "unit": {
              "const": "m"
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_class",
                "applicable_variant",
