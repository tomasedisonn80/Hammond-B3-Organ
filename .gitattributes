# Checked-in text has one raw-byte identity on every checkout platform.
* text=auto eol=lf

# Source documents and rendered/compiled evidence must never be translated.
*.pdf binary
*.wav binary
*.f32 binary
*.b3p binary

# Replay evidence includes deliberate CRLF and surrounding whitespace.
# Preserve the exact observed state bytes instead of normalizing their text.
docs/development/**/reports/**/*.b3controls -text
docs/development/2026-11-14-reference-refinement/reports/A20-workspace-replay/**/*.b3controls -text -whitespace

# Exact command-log evidence includes CMake's whitespace-only status prefixes.
docs/development/2026-11-14-reference-refinement/reports/*.log -text -whitespace

# Preserve exact primary-log excerpt bytes, including timestamp-only trailing spaces.
docs/development/2026-11-14-reference-refinement/reports/A43-26ff-primary-log-excerpts.txt -text -whitespace
docs/development/2026-11-14-reference-refinement/reports/A43-f9c-primary-log-excerpts.txt -text -whitespace
docs/development/2026-11-14-reference-refinement/reports/A56-primary-log-excerpts.txt -text -whitespace

# Preserve waveform-session raw command logs and exact unified-diff evidence.
docs/development/2026-11-14-waveform-continuation/reports/*.txt -text -whitespace
docs/development/2026-11-14-waveform-continuation/reports/*.patch -text -whitespace
docs/development/2026-11-14-waveform-continuation/reports/full-waveform/build-before-run.log -text -whitespace
