# Checked-in text has one raw-byte identity on every checkout platform.
* text=auto eol=lf

# Source documents and rendered/compiled evidence must never be translated.
*.pdf binary
*.wav binary
*.f32 binary
*.b3p binary

# Replay evidence includes deliberate CRLF and surrounding whitespace.
# Preserve the exact observed state bytes instead of normalizing their text.
docs/development/**/reports/**/*.b3controls -text
