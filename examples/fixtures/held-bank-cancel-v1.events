# Synthetic nominal fixture: held-bank-cancel-v1.
# frames=144000 sample_rate=48000 seed=2604 drawbars=008000000
# One held A4 key: B initially sounds 8-foot/tone 46; A sounds 4-foot/tone 58.
# BankDrawbar index is bank*9+drawbar, with A=0 and B=1.
# Dry ideal routing steps can click; no physical preset/loading claim is made.
0 expression upper 0 0.5
0 bank_drawbar upper 3 8
4807 note_on upper 69 100

# Select A without another note-on, then quietly edit the inactive B bank.
24013 select_bank upper 0 0
36019 bank_drawbar upper 11 6

# Cancel retains the key and both banks. Editing selected A does not reconnect.
48023 cancel upper 0 0
60029 drawbar upper 3 7

# Reselect B and then A: the held key returns at each bank's retained level.
# Deliberately uneven frames also expose accidental oscillator phase resets.
72031 select_bank upper 0 1
96043 select_bank upper 0 0

# Panic releases the key; a subsequent bank selection cannot revive it.
120047 all_notes_off upper 0 0
120047 select_bank upper 0 1
