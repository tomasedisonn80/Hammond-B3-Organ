      "held_targets",
      "modal_focus"
    ],
    "reason_for_exclusions": "Dimension-only resize batches must retain the existing maximum-plan drain guarantee. Audio/control state and modal focus have their existing separate observation/acknowledgment contracts; do not add audio-dependent rendering gates.",
    "unchanged": [
      "ScriptedInput parser, plan, source ordering, resize/marker identity and delivery semantics",
      "record_painted_presentation and diagnostic schemas",
      "record_replay_ui_observation and musical observation/acknowledgment guards",
      "Engine, Session, audio/MIDI callbacks, parameters, saved state, plugin identities, painter and controls",
      "256-event per-turn drain, 256-action plan, 512-entry presentation history, 10000ms plan maximum and 2000ms drain guard",
