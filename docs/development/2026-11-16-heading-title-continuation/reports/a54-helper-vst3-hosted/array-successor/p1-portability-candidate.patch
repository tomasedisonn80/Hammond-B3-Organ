+def admit_fixture_source(source_bytes, *, candidate_only):
+    """Accept original bytes or one exact reversible candidate-only fixture."""
+    require(type(candidate_only) is bool, "fixture admission mode must be boolean")
+    require(type(source_bytes) is bytes, "fixture admission requires complete byte source")
+    observed = sha(source_bytes)
+    original = PINNED[FIXTURE]
+    admission = dict(variant="original-fixture", candidate_only=candidate_only,
+                     original_pinned_sha256=original, observed_sha256=observed,
+                     accepted_sha256=original, transition=None,
+                     claim="Source admission only; coherent build and runtime acceptance remain separate.")
+    if observed == original:
+        return admission
+    require(candidate_only, "paired mode requires original P1 fixture")
+    require(observed == FIXTURE_PORTABILITY_SHA256,
+            "fixture does not match exact admitted portability source")
+    restored, replacements = source_bytes, {}
+    for name, before, after in reversed(FIXTURE_PORTABILITY_REPLACEMENTS):
+        count = restored.count(after)
+        require(count == 1, "fixture portability requires one exact replacement: " + name)
+        restored = restored.replace(after, before, 1)
+        replacements[name] = dict(before_bytes=len(before), before_sha256=sha(before),
+                                  after_bytes=len(after), after_sha256=sha(after), occurrences=count)
+    require(sha(restored) == original, "fixture reversal does not reconstruct original bytes")
+    admission.update(variant=FIXTURE_PORTABILITY_ID, accepted_sha256=observed,
+                     transition=dict(id=FIXTURE_PORTABILITY_ID, scope="candidate-only",
+                                     replacements=replacements, reversed_sha256=sha(restored),
+                                     whole_file_reversal_verified=True))
+    return admission
+
+
+def pin_fixture_source(inputs, root, *, candidate_only):
+    resolved = pin_input(inputs, FIXTURE, root / FIXTURE)
+    item = inputs[FIXTURE]
+    with resolved.open("rb") as stream:
+        source_bytes = stream.read(item["bytes"] + 1)
+    require(len(source_bytes) == item["bytes"] and sha(source_bytes) == item["sha256"],
+            "fixture source changed while reading registered input")
+    admission = admit_fixture_source(source_bytes, candidate_only=candidate_only)
+    item["expected_sha256"] = admission["accepted_sha256"]
+    item["original_pinned_sha256"] = PINNED[FIXTURE]
+    return admission
+
