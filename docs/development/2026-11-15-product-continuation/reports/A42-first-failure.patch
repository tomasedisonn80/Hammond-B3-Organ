+        if (scene == 0 || scaled) {
+            auto long_info = info;
+            long_info.midi_choices = long_choices;
+            long_info.midi_backend = long_text;
+            long_info.midi_status = long_text;
+            long_info.midi_reconnect_pending = true;
+            const auto long_frame = target.paint(model, long_info);
