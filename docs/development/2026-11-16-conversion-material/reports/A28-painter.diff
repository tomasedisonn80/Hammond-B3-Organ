                  ivory ? UiColor{244, 224, 186} : shade(cap, 34));
-    centered(drawing, label, geometry.label_bounds, (mixture ? 11.0F : 19.0F) * scale.f,
-             kUiIvory, mixture ? TextFace::Sans : TextFace::Serif, 2.0F * scale.sx);
