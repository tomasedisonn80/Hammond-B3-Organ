  "review_categories": [
    {
      "area": "Strict versus progress semantics",
      "existing_methods": [
        "test_progress_reports_exact_hashes_and_never_mutates_inputs",
        "test_default_strict_cli_rejects_partial_and_progress_is_explicit",
        "test_complete_synthetic_fixture_requires_sixty_unique_accepted_notes"
      ],
      "finding": "No false strict completion path identified: absent/running records fail strict mode; progress never certifies completion, including a complete synthetic fixture."
    },
    {
      "area": "Session identity, distinct workers and six-per-wave accounting",
      "existing_methods": [
        "test_other_sessions_unassigned_notes_and_row_order_do_not_add_workers",
        "test_exact_manifest_schema_numbers_and_identity",
        "test_row_types_required_fields_and_no_planned_placeholders",
        "test_ids_waves_names_duplicates_and_mismatches_are_rejected"
      ],
      "finding": "Canonical exact schema/start/session, unique ID/agent/path requirements and derived wave mapping prevent records from another session, malformed IDs, duplicate rows or planned status from satisfying strict completion. Dispatch and concurrency remain external facts."
    },
    {
      "area": "Bounded text/JSON and exact note hashes",
      "existing_methods": [
        "test_text_and_hash_types_are_bounded_and_not_placeholder_values",
        "test_duplicate_json_numbers_encoding_and_depth_fail_without_tracebacks",
        "test_note_hash_changes_and_raw_crlf_identity"
      ],
      "finding": "Inputs reject invalid type/number/encoding/depth/duplicate-key forms; raw note digest detects changed bytes and preserves CRLF distinctions."
    },
    {
      "area": "Narrative structure and running evidence",
      "existing_methods": [
        "test_structural_floor_excludes_code_comments_repetition_and_placeholders",
        "test_missing_accepted_note_and_running_optional_evidence"
      ],
      "finding": "Accepted notes require 100 regex tokens and 40 distinct tokens with simple comments/fence/indent exclusions. Running rows can omit evidence or name an unwritten note without hash. This floor is not semantic acceptance."
    },
    {
      "area": "Path admission and bounded reads",
      "existing_methods": [
        "test_safe_session_note_paths_are_required_in_both_modes",
        "test_input_size_limits_are_exact_and_bounded",
        "test_nonregular_files_and_symlink_leaves_cannot_be_evidence",
        "test_fifos_are_rejected_before_open",
        "test_symlinked_parent_and_repository_root_are_rejected",
        "test_windows_reparse_metadata_rejects_root_parent_and_leaf",
        "test_changed_file_during_open_and_read_is_rejected",
        "test_fdopen_failure_releases_the_acquired_descriptor"
      ],
      "finding": "Normalized within-session assignment-specific files, regular-file checks, symlink/reparse rejection, bounded reads and observed mutation checks cover the intended stable local/CI records."
    }
  ],
