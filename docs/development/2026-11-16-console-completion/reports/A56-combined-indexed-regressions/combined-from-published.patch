+                self.assertEqual(reader.ARRAY_ORIGINAL_BYTES, ORIGINAL_ARRAY)
+                self.assertEqual(reader.ARRAY_INDEXED_BYTES, INDEXED_ARRAY)
+            for variant in ("original", "indexed"):
+                with self.subTest(reader=item["name"], variant=variant):
